# ──────────────────────────────────────────────────────────────────────────────
# PBG Chatbot Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Required: Your Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default model (default: gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-pro
# GEMINI_MODEL=gemini-2.0-flash

# ──────────────────────────────────────────────────────────────────────────────
# FUTURE — RAG Pipeline (uncomment when implementing rag_stub.py)
# ──────────────────────────────────────────────────────────────────────────────

# Google Drive service account credentials JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Google Drive folder ID containing PBG regulatory documents
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Pinecone (if using Pinecone as vector store)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=pbg-knowledge
